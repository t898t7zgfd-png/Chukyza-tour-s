{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User profile document stored in Firestore",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "name": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["uid", "email"]
    },
    "Booking": {
      "title": "Tour Booking",
      "description": "Reservation details for off-road tour",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "tourId": { "type": "string" },
        "packageId": { "type": "string" },
        "date": { "type": "string" },
        "guests": { "type": "number" },
        "vehicleType": { "type": "string" },
        "status": { "type": "string" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["userId", "tourId", "date"]
    },
    "SavedRoute": {
      "title": "Saved Route",
      "description": "User's bookmarked or favorite tour route",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "tourId": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["userId", "tourId"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profiles"
    },
    "/bookings/{bookingId}": {
      "schema": { "$ref": "#/entities/Booking" },
      "description": "Tour bookings"
    },
    "/saved_routes/{savedRouteId}": {
      "schema": { "$ref": "#/entities/SavedRoute" },
      "description": "Saved tour routes"
    }
  }
}
